# Book Reading Application - Environment Configuration
# Copy this file to .env and fill in your values

# ====================
# LLM API Keys (Required for Agentic Translation)
# ====================

# Choose your LLM provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI API Key (get from https://platform.openai.com/api-keys)
# Required if using OpenAI/GPT models

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
# Required if using Gemini models

# Optional: Override default models
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-1.5-pro

# ====================
# Database Configuration
# ====================
# Password for PostgreSQL database (required)
POSTGRES_PASSWORD=your-secure-password-here

DATABASE_URL=postgres://bookreading:bookreading123@localhost:5432/bookreading?sslmode=disable

# ====================
# JWT Secret (for authentication)
# ====================
JWT_SECRET=your-production-jwt-secret-change-this

# ====================
# Service URLs (for local development)
# ====================
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080

# ====================
# Stripe Configuration (Required for Payments)
# ====================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/app/settings
