# Book Reading Application - Environment Configuration
# Copy this file to .env and fill in your values

# ====================
# LLM API Keys (Required for Agentic Translation)
# ====================

# Choose your LLM provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI API Key (get from https://platform.openai.com/api-keys)
# Required if using OpenAI/GPT models

# Google Gemini API Key (get from https://aistudio.google.com/app/apikey)
# Required if using Gemini models

# Optional: Override default models
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-1.5-pro

# ====================
# Database Configuration
# ====================
# Password for PostgreSQL database (required)
POSTGRES_PASSWORD=your-secure-password-here

DATABASE_URL=postgres://bookreading:bookreading123@localhost:5432/bookreading?sslmode=disable

# ====================
# JWT Secret (for authentication)
# ====================
JWT_SECRET=your-production-jwt-secret-change-this

# ====================
# Service URLs (for local development)
# ====================
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
# Peers allowed to set X-Forwarded-For/X-Real-IP for rate limiting
# (comma-separated IPs/CIDRs, or * for any). Empty = loopback + private ranges.
TRUSTED_PROXIES=
# Host interface for the ai-service port in docker-compose (default 127.0.0.1).
# Keep 127.0.0.1 unless AI_SERVICE_TOKEN is set (or an auth proxy is in front).
AI_SERVICE_BIND=127.0.0.1
# Optional shared secret: when set, ai-service requires
# "Authorization: Bearer <token>" on every non-health route and the Go backend
# sends it. The browser calls ai-service directly today, so setting it breaks
# those frontend features until they are proxied through the backend.
# Never expose it as a NEXT_PUBLIC_* variable.
AI_SERVICE_TOKEN=
# Extra novel hosts /scrape may fetch besides the built-in supported sites
# (comma-separated; subdomains included). Private/internal IPs are always refused.
SCRAPE_EXTRA_ALLOWED_HOSTS=
# Extra manga chapter hosts for /manga/fetch, and extra image/CDN hosts for
# /manga/translate-url page images (built-in lists live in site_routing.py /
# url_safety.py). Same rules: comma-separated, subdomains included.
MANGA_EXTRA_ALLOWED_HOSTS=
MANGA_IMAGE_EXTRA_ALLOWED_HOSTS=

# ====================
# Stripe Configuration (Required for Payments)
# ====================
# Leave STRIPE_SECRET_KEY and every STRIPE_PRICE_* empty to run with billing
# disabled (checkout answers 503). Once STRIPE_SECRET_KEY is set, the backend
# refuses to start unless each STRIPE_PRICE_* holds a recurring Stripe Price ID
# (price_...) from the Stripe dashboard; the charged amount comes from Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
# Public frontend origin for Stripe checkout success/cancel redirects
FRONTEND_URL=http://localhost:3000
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/app/settings
