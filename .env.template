# ====================
# LLM API Keys (Required for Agentic Translation)
# ====================
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ====================
# Database Configuration
# ====================
DATABASE_URL=postgres://bookreading:${POSTGRES_PASSWORD}@localhost:5432/bookreading?sslmode=disable

# ====================
# PostgreSQL Password (MUST be changed from default!)
# ====================
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# ====================
# JWT Secret (MUST be changed - use: openssl rand -hex 32)
# ====================
JWT_SECRET=CHANGE_ME_TO_SECURE_JWT_SECRET

# ====================
# Service URLs
# ====================
AI_SERVICE_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080

# ====================
# CORS Allowed Origins (comma-separated)
# ====================
ALLOWED_ORIGINS=http://localhost:3000
